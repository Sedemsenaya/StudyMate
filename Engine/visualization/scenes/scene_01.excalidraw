{"type": "excalidraw", "version": 2, "source": "studymate", "elements": [{"id": "dd492ddcaffa4097", "type": "text", "x": 30, "y": 22, "width": 286.0, "height": 25.0, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 818629864, "version": 1, "versionNonce": 465143664, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Computer Science · Scene 1", "originalText": "Computer Science · Scene 1", "fontSize": 20, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "38335c86066b4bda", "type": "text", "x": 545.9, "y": 60, "width": 508.20000000000005, "height": 55.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 906488443, "version": 1, "versionNonce": 62364612, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "What is an Algorithm?", "originalText": "What is an Algorithm?", "fontSize": 44, "fontFamily": 5, "textAlign": "center", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "bb626ead953e4e0e", "type": "rectangle", "x": 1230, "y": 180, "width": 320, "height": 160, "angle": 0.03, "strokeColor": "#e8c547", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 476079231, "version": 1, "versionNonce": 940356433, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "963e9609527e4cad", "type": "text", "x": 1250, "y": 200, "width": 290.40000000000003, "height": 110.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1064748683, "version": 1, "versionNonce": 500545053, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Algorithms are\nstep-by-step recipes;\ndata structures organize\ndata for efficient use.", "originalText": "Algorithms are\nstep-by-step recipes;\ndata structures organize\ndata for efficient use.", "fontSize": 22, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "3133e3523515428d", "type": "rectangle", "x": 120, "y": 728.0, "width": 1360, "height": 142.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "#343a40", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 742385985, "version": 1, "versionNonce": 495782128, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "99fdd670519642fa", "type": "text", "x": 145, "y": 743.0, "width": 1100.0, "height": 100.0, "angle": 0, "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 469828693, "version": 1, "versionNonce": 986990923, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "An algorithm is like a recipe that tells a computer exactly what steps to follow to solve a problem.\nA data structure is like a special way to organize data so that the algorithm can use it\nefficiently. Choosing the right algorithm and data structure can make a program run thousands of\ntimes faster.", "ori