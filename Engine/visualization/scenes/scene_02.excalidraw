{"type": "excalidraw", "version": 2, "source": "studymate", "elements": [{"id": "d82515a64fd648f6", "type": "text", "x": 30, "y": 22, "width": 286.0, "height": 25.0, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 698239131, "version": 1, "versionNonce": 372779024, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Computer Science · Scene 2", "originalText": "Computer Science · Scene 2", "fontSize": 20, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e807abb074314a51", "type": "text", "x": 388.59999999999997, "y": 60, "width": 822.8000000000001, "height": 55.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 293555410, "version": 1, "versionNonce": 772431398, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Searching: Linear vs Binary Search", "originalText": "Searching: Linear vs Binary Search", "fontSize": 44, "fontFamily": 5, "textAlign": "center", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "92b0cb8959e9410a", "type": "rectangle", "x": 1230, "y": 180, "width": 320, "height": 130, "angle": 0.03, "strokeColor": "#e8c547", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 390505926, "version": 1, "versionNonce": 956999484, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "a84e6ae771ec4189", "type": "text", "x": 1250, "y": 200, "width": 278.3, "height": 82.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 890499184, "version": 1, "versionNonce": 782232770, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Binary search is faster\nbecause it halves the\nlist each time.", "originalText": "Binary search is faster\nbecause it halves the\nlist each time.", "fontSize": 22, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "c65d31f576db4085", "type": "rectangle", "x": 120, "y": 728.0, "width": 1360, "height": 142.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "#343a40", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 759751758, "version": 1, "versionNonce": 777145086, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "848337e08a744e80", "type": "text", "x": 145, "y": 743.0, "width": 1078.0, "height": 100.0, "angle": 0, "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 957281566, "version": 1, "versionNonce": 346141402, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Linear search checks each item one by one, like looking through a book from the first page. Binary\nsearch is much faster, but it only works on a sorted list. It checks the middle item, and if it's\nnot the target, it throws away half the list and repeats. This makes binary search much more\nefficient.", "originalText": "Linear search checks each item one by one, like looking through a book from the first page. Binary\nsearch is much faster, but it only works on a sorted list. It checks the middle item, and if it's\nnot the target, it throws away half the list and repeats. This makes binary search much more\nefficient.", "fontSize": 20, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "e4332397fc084880", "type": "rectangle", "x": 256.35, "y": 265.75, "width": 197.3, "height": 63.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#FFB6C1", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 121443152, "version": 1, "versionNonce": 196676842, "isDeleted": false, "boundElements": [{"id": "9f3217924965451c", "type": "text"}, {"id": "01ab83334af64a5a", "type": "arrow"}, {"id": "7044d5a8f82641bd", "type": "arrow"}], "updated": 1, "link": null, "locked": false}, {"id": "9f3217924965451c", "type": "text", "x": 276.35, "y": 283.75, "width": 157.3, "height": 27.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 182261231, "version": 1, "versionNonce": 775365020, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Linear Search", "originalText": "Linear Search", "fontSize": 22, "fontFamily": 5, "textAlign": "center", "verticalAlign": "middle", "containerId": "e4332397fc084880", "lineHeight": 1.25, "autoResize": true}, {"id": "28b2b6ec9eec44e7", "type": "line", "x": 371.5399608368932, "y": 202.61061232762097, "width": 28.460039163106803, "height": 27.511907848715328, "angle": 0, "strokeColor": "#000", "backgroundColor": "#ff00", "fillStyle": "solid", "strokeWidth": 1.5144503647049234, "strokeStyl