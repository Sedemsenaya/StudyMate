graph TD
    %% scene: 1
    %% title: Layer Positioning
    %% explain: The transport layer's role in the protocol stack
    %% voice: The transport layer sits between application processes and the network layer. It ensures data reaches the correct process on each host.
    subgraph Scene1["Layer Positioning"]
        A[Application Layer] --> B[Transport Layer]
        B --> C[Network Layer]
        style A fill:#87CEEB
        style B fill:#98FB98
        style C fill:#FFB6C1
    end

    %% scene: 2
    %% title: Ports and Sockets
    %% explain: How processes are identified through ports and sockets
    %% voice: A port number identifies a process. A socket combines an IP address and port number for data routing. Multiplexing directs data to the right process.
    subgraph Scene2["Ports and Sockets"]
        D[Process] --> E[Port Number]
        F[IP Address] --> G[Socket]
        H[Data] --> I[Multiplexing]
        style D fill:#ADD8E6
        style E fill:#DDA0DD
        style F fill:#98FB98
        style G fill:#FFB6C1
        style H fill:#9370DB
    end

    %% scene: 3
    %% title: TCP vs UDP
    %% explain: Key differences between the two protocols
    %% voice: TCP is connection-oriented with reliability guarantees. UDP is connectionless with lower overhead. Choose TCP for web pages and email, UDP for video calls and games.
    subgraph Scene3["TCP vs UDP"]
        J[TCP] --> K["Reliable\nOrdered\nFlow Control"]
        L[UDP] --> M["Unreliable\nNo Order\nLow Overhead"]
        N[Web Pages] --> O[TCP]
        P[Video Calls] --> Q[UDP]
        style J fill:#7FFF00
        style K fill:#FFA07A
        style L fill:#ADD8E6
        style M fill:#DDA0DD
        style N fill:#FFB6C1
        style O fill:#98FB98
        style P fill:#87CEEB
        style Q fill:#FFD700
    end

    %% scene: 4
    %% title: Protocol Stack
    %% explain: Data flow through the protocol stack
    %% voice: Data travels from application to network layer through the transport layer. Each layer adds headers for routing and delivery.
    subgraph Scene4["Protocol Stack"]
        R[Application] --> S[Transport]
        T[Network] --> U[Physical]
        style R fill:#87CEEB
        style S fill:#98FB98
        style T fill:#FFB6C1
        style U fill:#DDA0DD
    end